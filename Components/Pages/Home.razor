@page "/"
@rendermode InteractiveServer
@using BudgetApp.Interfaces
@implements IDisposable
@inject IGoogleSheetsService SheetsService

<PageTitle>Home</PageTitle>

<h1>Budget App</h1>

<div class="d-flex align-items-end gap-2 my-3">
    <div>
        <label class="form-label" for="month">Month</label>
        <input id="month" type="month" class="form-control" @bind="selectedMonth" disabled="@isImporting" />
    </div>
    <button class="btn btn-primary" @onclick="ImportAsync" disabled="@isImporting">
        @if (isImporting)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            <span role="status">Importing…</span>
        }
        else
        {
            <span>Import transactions</span>
        }
    </button>
</div>

@if (transactionCount is not null)
{
    <div class="alert alert-success">
        <strong>@transactionCount</strong> transactions returned for @importedMonth.ToString("MMMM yyyy").
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger" style="white-space: pre-wrap">@error</div>
}

@code {
    private DateTime selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime importedMonth;
    private bool isImporting;
    private int? transactionCount;
    private string? error;

    // Cancels an in-progress import if the user leaves the page.
    private readonly CancellationTokenSource disposalCts = new();

    private async Task ImportAsync()
    {
        isImporting = true;
        transactionCount = null;
        error = null;

        try
        {
            importedMonth = selectedMonth;
            transactionCount = await SheetsService.ImportTransactionsAsync(
                importedMonth.Year, importedMonth.Month, disposalCts.Token);
        }
        catch (OperationCanceledException) when (disposalCts.IsCancellationRequested)
        {
            // Page was closed mid-import; nothing to show.
        }
        catch (Exception ex)
        {
            error = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    public void Dispose()
    {
        disposalCts.Cancel();
        disposalCts.Dispose();
    }
}
